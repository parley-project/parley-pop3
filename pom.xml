<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-pop3</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Parley POP3</name>
	<description>A POP3 server (RFC 1939, with CAPA, STLS, AUTH PLAIN and UTF8), built on parley-net and
		serving the parley-mail store. Split out of us.bringardner:bjl_email.</description>
	<inceptionYear>2026</inceptionYear>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.pop3</parley.moduleName>
		<junit.version>5.11.4</junit.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<!-- Small heap on purpose: message bodies must stay out of memory. -->
						<argLine>-Xmx64m</argLine>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- The test classes (TestPop3Server's keystore helper) as parley-pop3-<version>-tests.jar;
			     parley-imap's tests use it with <type>test-jar</type><scope>test</scope>. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Attaches the -sources.jar. The version comes from parley-parent; package (not deploy)
			     so the source jar is attached BEFORE the deploy plugin runs. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- GitHub Packages, used by release.sh. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/parley-pop3</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<!-- Messages and the mail store -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-mail</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Server, sessions, TLS, authentication -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-net</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
